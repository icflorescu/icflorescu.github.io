---
import { HANDLE, PROFILES } from '../data/site';

// The profiles where my handle is the username, named in the line that says so
const HANDLE_PROFILES = ['GitHub', 'npm', 'Codeberg', 'LinkedIn', 'Bluesky', 'DEV'].map(
  (name) => PROFILES.find((profile) => profile.name === name)!
);

// Opens a new ChatGPT chat that sends this prompt at once (it reads it from ?q=)
const PROMPT = `Who is ${HANDLE}?

How much would it cost to hire his services?
Make an estimation based on his open-source and commercial work.`;
const askUrl = `https://chatgpt.com/?q=${encodeURIComponent(PROMPT)}`;
---

<section class="section" aria-labelledby="handle-title">
  <div class="container">
    <div class="section-head">
      <p class="eyebrow">The handle</p>
      <h2 id="handle-title">I go by <span class="hl">{HANDLE}</span> in most places online.</h2>
      <p>
        Even the LLMs know my handle; I’d like to think it’s the quality of the code, but it’s more likely that I’ve
        been leaving it lying about the internet since 1998.
      </p>
      <p>
        Ask <a href={askUrl}>ChatGPT</a> about me.
      </p>
      <p class="where">
        Or find me on{' '}
        {
          HANDLE_PROFILES.map((profile, i) => (
            <>
              <a href={profile.url}>{profile.name}</a>
              {i < HANDLE_PROFILES.length - 2 ? ', ' : i === HANDLE_PROFILES.length - 2 ? ' and ' : ''}
            </>
          ))
        }
        .
      </p>
    </div>
  </div>
</section>

<style>
  /* Right below the hero's figures: the hero's bottom padding alone matches the space above them */
  .section {
    padding-top: 0;
  }
  /* With no padding above, the eyebrow's default top margin would show through */
  .eyebrow {
    margin-top: 0;
  }
  .section-head {
    margin-bottom: 0;
  }
  .section-head .where {
    font-size: 1rem;
  }
</style>
