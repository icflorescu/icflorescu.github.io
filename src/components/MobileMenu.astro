---
// The section menu below 62rem, where the header hides its inline links: a button that opens a native
// popover panel under the header. It opens, and closes on Esc or a tap outside, without JS.
// Both elements render where the component is placed (the start of the header row); the panel itself
// lives in the top layer once open, so its place in the markup doesn't affect the row.
interface Props {
  items: { href: string; label: string }[];
}

const { items } = Astro.props;
---

<button type="button" class="menu-toggle" popovertarget="menu" aria-label="Menu">
  {/* Three bars that fold into an X while the menu is open */}
  <span class="bars" aria-hidden="true"><span></span><span></span><span></span></span>
</button>
<div id="menu" class="menu" popover>
  <nav class="panel" aria-label="Sections">
    <ul>
      {
        items.map((item) => (
          <li>
            <a class="nav-link" href={item.href}>{item.label}</a>
          </li>
        ))
      }
    </ul>
  </nav>
  {/* Fills the rest of the screen, dimming the page; a tap on it closes the menu, without JS too */}
  <button type="button" class="scrim" popovertarget="menu" popovertargetaction="hide" tabindex="-1" aria-hidden="true"></button>
</div>

<script>
  // Picking a section closes the menu (without JS it stays open until Esc or a tap outside).
  const menu = document.querySelector<HTMLElement>('#menu')!;
  menu.addEventListener('click', (event) => {
    if ((event.target as Element).closest('a')) menu.hidePopover();
  });

  // So does a swipe up, anywhere on it: at least 40px, more up than sideways. On a panel that can still
  // scroll down (a phone in landscape), the swipe scrolls it instead.
  const panel = menu.querySelector<HTMLElement>('.panel')!;
  let start: { x: number; y: number } | null = null;
  menu.addEventListener(
    'touchstart',
    (event) => {
      const touch = event.touches[0]!;
      const scrollsDown =
        panel.contains(event.target as Node) && panel.scrollTop + panel.clientHeight < panel.scrollHeight - 1;
      start = event.touches.length === 1 && !scrollsDown ? { x: touch.clientX, y: touch.clientY } : null;
    },
    { passive: true }
  );
  menu.addEventListener('touchend', (event) => {
    if (!start) return;
    const touch = event.changedTouches[0]!;
    const up = start.y - touch.clientY;
    const sideways = Math.abs(touch.clientX - start.x);
    start = null;
    if (up >= 40 && up > sideways) menu.hidePopover();
  });
  menu.addEventListener('touchcancel', () => {
    start = null;
  });
</script>

<style>
  /* Sized and colored like the header's theme toggle; on hover, only the icon brightens */
  .menu-toggle {
    display: inline-grid;
    place-items: center;
    flex: none;
    width: 2.25rem;
    height: 2.25rem;
    padding: 0;
    border: 0;
    border-radius: 0.5rem;
    background: transparent;
    color: var(--muted);
    cursor: pointer;
    transition: color 0.15s ease;
  }
  @media (hover: hover) {
    .menu-toggle:hover {
      color: var(--text);
    }
  }
  /* The bars sit stacked on the button's center line: the outer two slide onto the middle one, then
     turn into an X while it fades. Closing runs the same steps backwards. */
  .bars {
    position: relative;
    width: 1.125rem;
    height: 0.75rem;
  }
  .bars span {
    position: absolute;
    left: 0;
    top: calc(50% - 1px);
    width: 100%;
    height: 2px;
    border-radius: 1px;
    background: currentColor;
    transition:
      translate 0.15s ease 0.15s,
      rotate 0.15s ease,
      opacity 0s linear 0.15s;
  }
  .bars span:first-child {
    translate: 0 -0.3125rem;
  }
  .bars span:last-child {
    translate: 0 0.3125rem;
  }
  .menu-toggle:has(+ .menu:popover-open) .bars span {
    translate: 0 0;
    transition:
      translate 0.15s ease,
      rotate 0.15s ease 0.15s,
      opacity 0s linear 0.15s;
  }
  .menu-toggle:has(+ .menu:popover-open) .bars span:first-child {
    rotate: 45deg;
  }
  .menu-toggle:has(+ .menu:popover-open) .bars span:nth-child(2) {
    opacity: 0;
  }
  .menu-toggle:has(+ .menu:popover-open) .bars span:last-child {
    rotate: -45deg;
  }
  @media (prefers-reduced-motion: reduce) {
    .bars span,
    .menu-toggle:has(+ .menu:popover-open) .bars span {
      transition: none;
    }
  }

  /* The popover covers the screen under the header (4rem below 62rem, plus its 1px rule), which stays sharp
     so its button can close the menu. A column holding the menu panel, inset by the popover's padding; the
     scrim fills the whole popover behind it, gap included. */
  .menu {
    inset: calc(4rem + 1px) 0 0;
    width: auto;
    height: auto;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0.5rem;
    border: 0;
    background: transparent;
    color: var(--text);
    overflow: hidden;
    /* Here, not under :popover-open, so the column holds while the menu closes (otherwise panel and scrim
       flash side by side during the exit) */
    flex-direction: column;
    /* Keeps the popover (and so its children's exit transitions) on screen until they finish */
    transition:
      overlay 0.15s allow-discrete,
      display 0.15s allow-discrete;
  }
  .menu:popover-open {
    display: flex;
  }

  /* A glass card like the header. Scrolls on its own if taller than the screen (a phone in landscape). */
  .panel {
    /* Above the scrim, which follows it in the markup */
    position: relative;
    z-index: 1;
    flex: none;
    max-height: 100%;
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: 0.375rem 1rem;
    border: 1px solid var(--border);
    border-radius: 0.75rem;
    /* In dark mode lighter than the header (the raised surface tone, lifted further towards the text color),
       and with a denser shadow, so it stands off the dimmed page */
    background: light-dark(
      color-mix(in srgb, var(--bg) 85%, transparent),
      color-mix(in srgb, color-mix(in srgb, var(--surface) 92%, var(--text)) 85%, transparent)
    );
    box-shadow: 0 1rem 2.5rem -1rem light-dark(rgb(0 0 0 / 0.35), rgb(0 0 0 / 0.8));
    backdrop-filter: blur(10px);
  }
  /* Dims and blurs the page under the panel */
  .scrim {
    position: absolute;
    inset: 0;
    padding: 0;
    border: 0;
    background: light-dark(rgb(0 0 0 / 0.35), rgb(0 0 0 / 0.55));
    backdrop-filter: blur(6px);
    cursor: default;
  }

  /* The panel slides down from under the header and fades in, the scrim fades in; both reverse, a bit
     quicker, on the way out */
  .panel,
  .scrim {
    opacity: 0;
    transition:
      opacity 0.15s ease-in,
      transform 0.15s ease-in;
  }
  .panel {
    transform: translateY(-0.75rem);
  }
  .menu:popover-open .panel,
  .menu:popover-open .scrim {
    opacity: 1;
    transform: none;
    transition-duration: 0.25s;
    transition-timing-function: cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  @starting-style {
    .menu:popover-open .panel {
      opacity: 0;
      transform: translateY(-0.75rem);
    }
    .menu:popover-open .scrim {
      opacity: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .menu,
    .panel,
    .scrim {
      transition-duration: 0s;
    }
    .panel {
      transform: none;
    }
  }

  /* No page scrolling while the menu is open (html keeps its scrollbar gutter, so nothing shifts) */
  :global(html:has(#menu:popover-open)) {
    overflow: hidden;
  }

  /* Centered, like the brand in the header row above */
  ul {
    margin: 0;
    padding: 0;
    list-style: none;
    text-align: center;
  }
  /* .nav-link (global.css), larger and with taller tap targets than in the header row */
  a {
    --underline-bottom: 0.5rem;
    display: inline-block;
    padding: 0.625rem 0;
    font-size: 1.0625rem;
    font-weight: 500;
  }
  a:active {
    transform: translateY(1px);
  }

  /* From 62rem the header shows its own links */
  @media (min-width: 62.0625rem) {
    .menu-toggle,
    .menu {
      display: none;
    }
  }
</style>
