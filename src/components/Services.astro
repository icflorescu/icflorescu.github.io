---
const OFFERS = [
  {
    title: 'Fractional CTO & technical partner',
    body: 'For early-stage products that need a senior person to own the technical side: architecture, code, infrastructure, data and day-to-day operations. I treat software as a business asset, not a ticket queue.',
  },
  {
    title: 'Sweat-equity partnerships',
    body: "If the business side is covered and you need a technical co-owner, I'm open to trading equity for work, with me owning the technical side end to end. It's how I've worked with LeasingSH.ro since 2013.",
  },
  {
    title: 'Selected hands-on work',
    body: 'TypeScript, React, TanStack Start / Next.js, Node.js / Bun and PostgreSQL. Data-rich interfaces are home turf: I wrote Mantine DataTable, used by teams at Microsoft and Namecheap.',
  },
];

const PRINCIPLES = [
  {
    title: 'Built to last',
    body: 'Less code, fewer moving parts, technologies chosen for the next five years rather than the next conference talk.',
  },
  {
    title: 'Rule-heavy domains',
    body: "Insurance, leasing, tax: I'm at home where “almost right” means wrong, and every rule has to be traced to its source.",
  },
  {
    title: 'No cloud bill to dread',
    body: 'I self-host what I build, with Docker and Caddy on a plain VPS, and keep running it long after launch.',
  },
  {
    title: 'AI, without the hype',
    body: "I work with AI coding agents every day, and know where they help and where they don't.",
  },
];
---

<section class="section" id="services" aria-labelledby="services-title">
  <div class="container">
    <div class="section-head">
      <p class="eyebrow">What I offer</p>
      <h2 id="services-title">A senior technical partner who still writes the code</h2>
      <p>
        A comfortable degree of financial independence lets me pick projects for the problem and the people, and I'll
        tell you when something isn't worth building.
      </p>
    </div>
    <ul class="offers">
      {
        OFFERS.map((offer, i) => (
          <li class="card">
            <span class="num" aria-hidden="true">
              0{i + 1}
            </span>
            <h3>{offer.title}</h3>
            <p>{offer.body}</p>
          </li>
        ))
      }
    </ul>
    <ul class="principles">
      {
        PRINCIPLES.map((principle) => (
          <li>
            <h3>{principle.title}</h3>
            <p>{principle.body}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  /* One column, then all three at once (three 18rem cards fit): never two plus a lone one */
  .offers {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1rem;
  }
  @media (min-width: 60rem) {
    .offers {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  .offers li {
    padding: 1.75rem;
  }
  .num {
    display: inline-grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 0.5rem;
    background: var(--yellow);
    color: var(--ink);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.9375rem;
    transform: rotate(-3deg);
  }
  .offers h3 {
    margin-top: 1.25rem;
    font-size: 1.375rem;
  }
  .offers p {
    margin-top: 0.75rem;
    color: var(--muted);
  }
  /* One column, then two, then all four (once four 14rem columns fit): never three plus a lone one */
  .principles {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.5rem 2rem;
    margin-top: clamp(2.5rem, 6vw, 3.5rem);
  }
  @media (min-width: 33rem) {
    .principles {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 66rem) {
    .principles {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
  .principles li {
    padding-left: 1.5rem;
    border-left: 3px dashed var(--accent-line);
  }
  .principles h3 {
    font-size: 1.0625rem;
    letter-spacing: -0.01em;
  }
  .principles p {
    margin-top: 0.375rem;
    font-size: 0.9375rem;
    color: var(--muted);
  }
</style>
