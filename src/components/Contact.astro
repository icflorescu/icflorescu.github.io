---
import { BOOKING_URL } from '../data/site';
import EmailReveal from './EmailReveal.astro';
import Icon from './Icon.astro';
import Mark from './Mark.astro';
---

<section class="section contact" id="contact" aria-labelledby="contact-title">
  <div class="container">
    <div class="glimmer">
      <div class="box">
        <Mark size={88} class="mark" />
        <h2 id="contact-title">Building something?</h2>
        <p class="lead">
          Book a call or drop me an email, and tell me about your project. Mention that you found me here: I get quite a
          few messages, and it helps me prioritise yours.
        </p>
        <div class="cta">
          <a class="btn btn-primary" href={BOOKING_URL}><Icon name="talk" />Book a call</a>
          <EmailReveal />
        </div>
        <p class="note">
          I skip coding tests and multi-stage hiring processes: my code is public, and used by developers and companies
          worldwide. Instead, we’ll talk about your project: its value proposition, its challenges and how to overcome
          them, and how I can help make it happen.
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  /* A faint rim with a light running round it, as on swapp.ro: a conic gradient turning behind the card, whose
     surface covers all but the 2px edge. Paused out of view (script below); reduced motion leaves the rim. */
  .glimmer {
    --rim: light-dark(#fff2a0, #45401c);
    --light: light-dark(#d4b300, #c4ad28);
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding: 2px;
    border-radius: var(--radius);
    background: var(--rim);
    /* A faint gold glow under it (as on swapp.ro, where it's cyan), in each theme's gold */
    box-shadow:
      0 20px 25px -5px light-dark(rgb(212 179 0 / 0.07), rgb(196 173 40 / 0.08)),
      0 8px 10px -6px light-dark(rgb(212 179 0 / 0.07), rgb(196 173 40 / 0.08));
  }
  @media (prefers-reduced-motion: no-preference) {
    .glimmer::before {
      content: '';
      position: absolute;
      inset: -100%;
      z-index: -1;
      background: conic-gradient(transparent 50%, var(--light) 97%, transparent);
      animation: glimmer 5s linear infinite;
    }
    .glimmer[data-offscreen]::before {
      animation-play-state: paused;
    }
  }
  @keyframes glimmer {
    to {
      rotate: 1turn;
    }
  }
  .box {
    --backdrop: var(--surface);
    position: relative;
    padding: clamp(2rem, 6vw, 4rem);
    border-radius: calc(var(--radius) - 2px);
    background: var(--surface);
    text-align: center;
  }
  .box :global(.mark) {
    margin: 0 auto 1.25rem;
    transform: rotate(-4deg);
  }
  h2 {
    font-size: clamp(2rem, 5vw, 3rem);
  }
  .lead {
    margin: 1rem auto 0;
    max-width: 36rem;
    font-size: 1.125rem;
    color: var(--muted);
  }
  .cta {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
    margin-top: 2rem;
  }
  .note {
    margin: 2rem auto 0;
    max-width: 40rem;
    font-size: 0.9375rem;
    color: var(--muted);
  }
</style>

<script>
  // Stop the looping light while it's out of view, so it doesn't ask for frames for nothing
  const glimmer = document.querySelector<HTMLElement>('#contact .glimmer')!;
  new IntersectionObserver(([entry]) => glimmer.toggleAttribute('data-offscreen', !entry?.isIntersecting)).observe(glimmer);
</script>
