---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import contextmenu from '../assets/screens/mantine-contextmenu.png';
import datatable from '../assets/screens/mantine-datatable-home.png';
import pocketbaseUml from '../assets/screens/pocketbase-uml.png';
import trpcSveltekit from '../assets/screens/trpc-sveltekit.png';
import { SPONSORS_URL } from '../data/site';
import { compact, getStats, thousands } from '../data/stats';
import Count from './Count.astro';
import Icon from './Icon.astro';

const stats = await getStats();
const stars = (repo: string) => thousands(stats.stars[repo] ?? 0);
const asOf = new Date(`${stats.date}T00:00:00Z`).toLocaleDateString('en-GB', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
  timeZone: 'UTC',
});

const USERS = [
  'Microsoft',
  'Namecheap',
  'EasyWP',
  'kapa.ai',
  'SalesPlayX',
  'teachfloor',
  'MARKUP',
  'InvenTree',
  'OmicsStudio',
  'exdatis.ai',
  'Aquarino',
  'BookieBase',
  'COH3 Stats',
  'LeasingSH.ro',
  'swapp.ro',
];

const TESTIMONIALS = [
  {
    quote:
      'Mantine DataTable is a great component that’s core to our web app — it saves us a ton of time and comes with great styling and features out of the box.',
    author: 'Emil Sorensen',
    org: 'kapa.ai',
    url: 'https://github.com/Emil-Sorensen',
  },
  {
    quote:
      'Thank you for the wonderful, useful, and beautiful DataTable that has allowed me to create several applications without any problem.',
    author: 'Giovambattista Fazioli',
    org: 'Lead Developer at Namecheap',
    url: 'https://github.com/gfazioli',
  },
];

type Project = {
  name: string;
  url: string;
  image: ImageMetadata;
  alt: string;
  text: string;
  downloads?: number;
  stars: number;
};

const PROJECTS: Project[] = [
  {
    name: 'Mantine ContextMenu',
    url: 'https://icflorescu.github.io/mantine-contextmenu/',
    image: contextmenu,
    alt: 'The Mantine ContextMenu documentation site, with a context menu open over a grid of cat pictures',
    text: "Right-click menus for Mantine apps, with a succinct API and dark-theme support. It grew out of DataTable's row context menu, which people kept asking to use elsewhere.",
    downloads: stats.monthly['mantine-contextmenu'] ?? 0,
    stars: stats.stars['mantine-contextmenu'] ?? 0,
  },
  {
    name: 'tRPC-SvelteKit',
    url: 'https://icflorescu.github.io/trpc-sveltekit/',
    image: trpcSveltekit,
    alt: "The tRPC-SvelteKit documentation site's home page",
    text: 'End-to-end typesafe APIs with tRPC in SvelteKit applications. Works with any SvelteKit adapter, with experimental WebSocket support.',
    downloads: stats.monthly['trpc-sveltekit'] ?? 0,
    stars: stats.stars['trpc-sveltekit'] ?? 0,
  },
  {
    name: 'PocketBaseUML',
    url: 'https://pocketbase-uml.github.io/',
    image: pocketbaseUml,
    alt: "A PocketBaseUML diagram of a PocketBase database's collections and their relations",
    text: 'A free UML diagram generator for PocketBase databases. Use it online, or run it locally with npx.',
    stars: stats.stars['pocketbase-uml.github.io'] ?? 0,
  },
];

const MORE = [
  {
    name: 'IISExpress-Proxy',
    url: 'https://github.com/icflorescu/iisexpress-proxy',
    text: `lets .NET developers reach IIS Express from other devices; still in use ten years on (${stars('iisexpress-proxy')} stars)`,
  },
  {
    name: 'Next.js Parallel Server Actions',
    url: 'https://github.com/icflorescu/next-server-actions-parallel',
    text: 'run Next.js server actions in parallel, for a tRPC-style workflow without the boilerplate',
  },
  {
    name: 'Expose-WSL',
    url: 'https://github.com/icflorescu/expose-wsl',
    text: `probably the easiest way to expose apps running on WSL to your local network (${stars('expose-wsl')} stars)`,
  },
  {
    name: 'Mantine Start',
    url: 'https://github.com/icflorescu/mantine-start',
    text: 'a starter for Mantine, TanStack Start and tRPC applications',
  },
  {
    name: 'ASPAX',
    url: 'https://aspax.github.io/',
    text: 'a Node.js asset packager, in 2013, before Webpack existed',
  },
  {
    name: 'OpenShift cartridges',
    url: 'https://github.com/icflorescu/openshift-cartridge-nodejs',
    text: 'Node.js, MongoDB, MySQL and PostgreSQL for Red Hat OpenShift, in 2014–2016, before Docker went mainstream',
  },
];
---

<section class="section" id="open-source" aria-labelledby="oss-title">
  <div class="container">
    <div class="section-head">
      <p class="eyebrow">Open source</p>
      <h2 id="oss-title">My code is public. Judge the work.</h2>
      <p>
        Typed APIs, real docs and a docs site I design myself, every time. My packages add up to {
          compact(stats.yearlyDownloads)
        } npm downloads over the past year, and most of the code was written by hand, years before AI coding assistants.
      </p>
    </div>

    <article class="card featured">
      <div class="featured-body">
        <p class="role">Since 2022 · my most popular project</p>
        <h3>
          <a href="https://icflorescu.github.io/mantine-datatable/"><span class="underline-grow">Mantine DataTable</span> <Icon name="arrow" /></a>
        </h3>
        <p>
          The table component for data-rich Mantine applications: asynchronous data loading, pagination, sorting, row
          selection, row expansion, context menus and dark-theme support, all fully typed. Lightweight and
          dependency-free, with a legacy version still maintained for teams that can't upgrade yet.
        </p>
        <dl class="numbers">
          <div>
            <dt>npm downloads a month</dt>
            <dd>
              <Count to={stats.monthly['mantine-datatable'] ?? 0} format="compact" />
            </dd>
          </div>
          <div>
            <dt>GitHub stars</dt>
            <dd>
              <Count to={stats.stars['mantine-datatable'] ?? 0} format="thousands" />
            </dd>
          </div>
        </dl>
        <p class="users-label">Used by developers and companies such as</p>
        <ul class="users">
          {USERS.map((user) => <li>{user}</li>)}
        </ul>
      </div>
      <a class="featured-shot img-link" href="https://icflorescu.github.io/mantine-datatable/" tabindex="-1" aria-hidden="true">
        <Image
          src={datatable}
          alt="The Mantine DataTable documentation site, with a data table showing row selection and a context menu"
          data-fade widths={[600, 900, 1400]} sizes="(max-width: 56rem) 100vw, 40rem" />
      </a>
    </article>

    <div class="testimonials">
      {
        TESTIMONIALS.map((t) => (
          <figure>
            <blockquote>“{t.quote}”</blockquote>
            <figcaption>
              <a href={t.url}>{t.author}</a>, {t.org}
            </figcaption>
          </figure>
        ))
      }
    </div>

    <ul class="projects">
      {
        PROJECTS.map((project) => (
          <li class="card">
            <a class="project-shot img-link" href={project.url} tabindex="-1" aria-hidden="true">
              <Image src={project.image} alt={project.alt} data-fade widths={[400, 700, 1000]} sizes="(max-width: 40rem) 100vw, (max-width: 60rem) 45vw, 22rem" />
            </a>
            <div class="project-body">
              <h3>
                <a href={project.url}><span class="underline-grow">{project.name}</span></a>
              </h3>
              <p>{project.text}</p>
              <p class="meta">
                {project.downloads !== undefined && (
                  <>
                    <Count to={project.downloads} format="compact" /> downloads/month ·{' '}
                  </>
                )}
                <Count to={project.stars} format="thousands" /> stars
              </p>
            </div>
          </li>
        ))
      }
    </ul>

    <div class="more">
      <h3>And a few more, old and new</h3>
      <ul>
        {
          MORE.map((item) => (
            <li>
              <a href={item.url}>{item.name}</a>: {item.text}
            </li>
          ))
        }
      </ul>
      <p class="more-links">
        <a href="https://github.com/icflorescu#notable-open-source-projects-ive-built-over-the-years"
          >Everything else is on GitHub</a
        >. I've also contributed to Mantine, tRPC and TanStack.
      </p>
    </div>

    <aside class="sponsors">
      <Icon name="heart" />
      <p>
        Thank you to everyone who <a href={SPONSORS_URL}>sponsors my work on GitHub</a>: it's what lets me keep these
        projects maintained, long after the excitement of launch wore off.
      </p>
    </aside>

    <p class="as-of">
      Figures from the GitHub and npm APIs, as of {asOf}; npm figures cover the last 30 days and the last 365 days.
    </p>
  </div>
</section>

<style>
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .role {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--muted);
  }
  /* Titles hover like the header menu: the accent underline grows under the name (.underline-grow, global.css),
     and the arrow brightens */
  h3 a {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    text-decoration: none;
  }
  h3 :global(svg) {
    width: 1.25rem;
    height: 1.25rem;
    color: var(--muted);
    transition: color 0.15s ease;
  }
  @media (hover: hover) {
    h3 a:hover :global(svg) {
      color: var(--text);
    }
  }

  .featured {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr);
    overflow: hidden;
  }
  .featured-body {
    padding: clamp(1.5rem, 3.5vw, 2.5rem);
  }
  .featured h3 {
    margin-top: 0.375rem;
    font-size: clamp(1.75rem, 3.4vw, 2.25rem);
  }
  .featured-body > p:not(.role, .users-label) {
    margin-top: 1rem;
  }
  .numbers {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 2.5rem;
    margin: 1.5rem 0;
  }
  .numbers div {
    display: flex;
    flex-direction: column-reverse;
  }
  .numbers dt {
    font-size: 0.875rem;
    color: var(--muted);
  }
  .numbers dd {
    margin: 0;
    font-family: var(--font-display);
    font-size: 2.25rem;
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.02em;
  }
  .users-label {
    font-size: 0.875rem;
    color: var(--muted);
  }
  .users {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1rem;
    margin-top: 0.5rem;
    font-weight: 600;
    font-size: 0.9375rem;
  }
  .featured-shot {
    display: flex;
    align-items: center;
    background: var(--shot-bg);
    padding: clamp(1.25rem, 3vw, 2rem);
  }
  .featured-shot :global(img) {
    width: 100%;
    border-radius: 0.75rem;
    box-shadow: 0 1rem 2.5rem -1rem rgb(0 0 0 / 0.35);
  }

  .testimonials {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr));
    gap: 1.5rem 2rem;
    margin: 2.5rem 0 3rem;
  }
  figure {
    margin: 0;
    padding-left: 1.5rem;
    border-left: 3px dashed var(--accent-line);
  }
  blockquote {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.1875rem;
    line-height: 1.45;
    letter-spacing: -0.01em;
  }
  figcaption {
    margin-top: 0.75rem;
    font-size: 0.9375rem;
    color: var(--muted);
  }

  /* One column, then all three at once (three 18rem cards fit): never two plus a lone one */
  .projects {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1rem;
  }
  @media (min-width: 60rem) {
    .projects {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  .projects li {
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }
  /* Edge to edge: the card's rounded corners clip it, and a hairline separates it from the text */
  .project-shot {
    display: block;
    /* PocketBaseUML's ratio, the widest of the three, so none is clipped at the sides; the taller ones lose a bit at the bottom */
    aspect-ratio: 5 / 3;
    background: var(--shot-bg);
    border-bottom: 1px solid var(--border);
    overflow: hidden;
  }
  .project-shot :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
  }
  .project-body {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: 1.25rem 1.5rem 1.5rem;
  }
  .project-body h3 {
    font-size: 1.25rem;
  }
  .project-body p {
    margin-top: 0.5rem;
    font-size: 0.9375rem;
    color: var(--muted);
  }
  .project-body .meta {
    margin-top: auto;
    padding-top: 0.75rem;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--text);
  }
  /* One per row but wide (640–960px): image on the left, filling the card's height, text on the right */
  @media (min-width: 40rem) and (max-width: 59.9375rem) {
    .projects li {
      flex-direction: row;
    }
    .project-shot {
      flex: 0 0 45%;
      aspect-ratio: auto;
      border-bottom: 0;
      border-right: 1px solid var(--border);
    }
    .project-shot :global(img) {
      object-position: top left;
    }
  }

  .more {
    margin-top: 3rem;
    max-width: 48rem;
  }
  .more h3 {
    font-size: 1.25rem;
  }
  .more ul {
    margin-top: 1rem;
    padding-left: 1.25rem;
    list-style: disc;
    color: var(--muted);
  }
  .more li::marker {
    color: var(--accent-line);
  }
  .more li + li {
    margin-top: 0.375rem;
  }
  .more li a {
    --link: var(--text);
    font-weight: 600;
  }
  .more-links {
    margin-top: 1rem;
    color: var(--muted);
  }

  .sponsors {
    display: flex;
    gap: 0.875rem;
    align-items: flex-start;
    margin-top: 2.5rem;
    padding: 1.25rem 1.5rem;
    border: 2px dashed var(--dash);
    border-radius: var(--radius);
    max-width: 48rem;
  }
  .sponsors :global(svg) {
    flex: none;
    width: 1.375rem;
    height: 1.375rem;
    margin-top: 0.1rem;
    color: #e5484d;
  }
  .as-of {
    margin-top: 1.5rem;
    font-size: 0.8125rem;
    color: var(--muted);
  }

  @media (max-width: 56rem) {
    .featured {
      grid-template-columns: 1fr;
    }
  }
</style>
