{
  // The copy uses real typography (’ “ ” – — … × ·), which the editor would otherwise flag as look-alikes of
  // ASCII characters. Invisible characters are still highlighted.
  "editor.unicodeHighlight.allowedCharacters": {
    "‘": true,
    "’": true,
    "“": true,
    "”": true,
    "–": true,
    "—": true,
    "…": true,
    "×": true,
    "·": true
  }
}
